{
  "name": "eastman-loupe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p worker && vite build",
    "preview": "vite preview",
    "sample": "node scripts/make-sample-scans.mjs samples/K7QM2XW9PA && node scripts/ingest-roll.mjs samples/K7QM2XW9PA --code K7QM2XW9PA --stock \"Portra 400\" --date 2026-10-17 --roll 0412",
    "ingest": "node scripts/ingest-roll.mjs",
