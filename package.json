    "deploy": "npm run build && npx wrangler deploy",
    "upload": "node scripts/upload-roll.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
